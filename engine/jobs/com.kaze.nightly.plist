<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kaze.nightly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/kaze/engine/jobs/run_job.sh nightly</string>
  </array>

  <!-- The nightly parity check and health line, once a day at 17:15 New York.
       NOTE: launchd's StartCalendarInterval uses the box's own local time and ignores the TZ below (that
       only scopes the spawned process). The station runs on Pacific, so Hour=14 Minute=15 is 14:15 PT,
       which is 17:15 ET year-round (PT is ET minus 3 hours through daylight saving). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>14</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>America/New_York</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
