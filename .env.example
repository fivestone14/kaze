# Copy to .env and fill in. .env is never committed. Every job reads these five keys.
KAZE_MIRAI_HOME=/path/to/mirai_awakening
KAZE_DATA=/path/to/kaze_data
# Optional: where the nightly keeps its last 5 dated, gzipped copies of the store (a folder another disk or
# a cloud sync carries). Unset, the copies land in KAZE_DATA/backups and the nightly warns they share the disk; set
# but absent on a night (a cloud folder signed out), that night's copy lands in KAZE_DATA/backups with one warning.
KAZE_BACKUP_DIR=/path/to/kaze_backups
# The phone app's server (app/server): the port it listens on at 127.0.0.1 and the one token the phone signs in
# with (HTTP Basic, user kaze). The server refuses to start without the token, and launchd restarts it every minute
# until it has one, so set it even before the phone is built.
# Make the token with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KAZE_APP_PORT=8791
KAZE_APP_TOKEN=paste-a-fresh-token-here
