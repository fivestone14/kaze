# Copy to .env and fill in. .env is never committed.
KAZE_MIRAI_HOME=/path/to/mirai_awakening
KAZE_DATA=/path/to/kaze_data
# Optional: where the nightly keeps its last 5 dated, gzipped copies of the store (a folder another disk or
# a cloud sync carries). Unset, the copies land in KAZE_DATA/backups and the nightly warns they share the disk.
KAZE_BACKUP_DIR=/path/to/kaze_backups
