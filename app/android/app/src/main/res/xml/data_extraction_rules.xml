<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the app holds the server token, so its data is excluded from cloud backup and from
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
